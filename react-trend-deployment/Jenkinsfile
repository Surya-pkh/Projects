pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = 'your-dockerhub-username/trend-app'
        DOCKER_CREDENTIALS = 'docker-credentials-id'
        KUBERNETES_CONFIG = 'eks-config'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${BUILD_NUMBER}")
                }
            }
        }
        
        stage('Push to DockerHub') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKER_CREDENTIALS) {
                        docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}").push()
                        docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}").push('latest')
                    }
                }
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    withKubeConfig([credentialsId: KUBERNETES_CONFIG]) {
                        sh """
                            kubectl apply -f kubernetes/namespace.yaml
                            sed -i 's|\${DOCKER_IMAGE}|${DOCKER_IMAGE}|g; s|\${IMAGE_TAG}|${BUILD_NUMBER}|g' kubernetes/deployment.yaml
                            kubectl apply -f kubernetes/deployment.yaml
                            kubectl apply -f kubernetes/service.yaml
                        """
                    }
                }
            }
        }
        
        stage('Deploy Monitoring') {
            steps {
                script {
                    withKubeConfig([credentialsId: KUBERNETES_CONFIG]) {
                        sh """
                            kubectl apply -f kubernetes/monitoring.yaml
                            # Wait for Prometheus and Grafana to be ready
                            kubectl wait --for=condition=available --timeout=300s deployment/prometheus -n monitoring
                            kubectl wait --for=condition=available --timeout=300s deployment/grafana -n monitoring
                            
                            # Get Grafana service URL
                            echo "Grafana will be available at: http://\$(kubectl get svc grafana -n monitoring -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')"
                        """
                    }
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
    }
}
