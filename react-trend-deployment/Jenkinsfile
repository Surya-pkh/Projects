pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = 'suryapkh/trend-app'
        AWS_DEFAULT_REGION = 'us-west-2'
        EKS_CLUSTER_NAME = 'trend-app-cluster'
        NAMESPACE = 'trend'
    }
    
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Surya-pkh/Projects.git'
                script {
                    env.GIT_COMMIT_SHA = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    env.BUILD_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT_SHA}"
                    echo "Building image tag: ${env.BUILD_TAG}"
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                script {
                    // Navigate to the react-trend-deployment directory
                    sh """
                        cd react-trend-deployment
                        echo "Building Docker image from react-trend-deployment directory"
                        
                        # Verify files exist
                        ls -la dist/
                        ls -la Dockerfile
                        ls -la nginx.conf
                    """
                    
                    // Build Docker image
                    sh """
                        cd react-trend-deployment
                        docker build -t ${DOCKER_IMAGE}:${env.BUILD_TAG} .
                        docker tag ${DOCKER_IMAGE}:${env.BUILD_TAG} ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }
        
        stage('Push to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh """
                            echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
                            docker push ${DOCKER_IMAGE}:${env.BUILD_TAG}
                            docker push ${DOCKER_IMAGE}:latest
                        """
                    }
                }
            }
        }
        
        stage('Deploy to EKS') {
            steps {
                script {
                    withCredentials([aws(credentialsId: 'aws-credentials', region: "${AWS_DEFAULT_REGION}")]) {
                        sh """
                            # Configure kubectl
                            aws eks update-kubeconfig --name ${EKS_CLUSTER_NAME} --region ${AWS_DEFAULT_REGION}
                            
                            # Update deployment with new image
                            kubectl set image deployment/trend-app trend-app=${DOCKER_IMAGE}:${env.BUILD_TAG} -n ${NAMESPACE}
                            
                            # Wait for rollout to complete
                            kubectl rollout status deployment/trend-app -n ${NAMESPACE} --timeout=300s
                            
                            # Show deployment status
                            kubectl get pods -n ${NAMESPACE}
                            kubectl get svc -n ${NAMESPACE}
                        """
                    }
                }
            }
        }
        
        stage('Health Check') {
            steps {
                script {
                    withCredentials([aws(credentialsId: 'aws-credentials', region: "${AWS_DEFAULT_REGION}")]) {
                        sh """
                            # Get LoadBalancer URL
                            LOAD_BALANCER_URL=\$(kubectl get svc trend-app-service -n ${NAMESPACE} -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
                            echo "LoadBalancer URL: http://\$LOAD_BALANCER_URL"
                            
                            # Health check with retries
                            for i in {1..5}; do
                                echo "Health check attempt \$i..."
                                if curl -f --max-time 10 http://\$LOAD_BALANCER_URL; then
                                    echo "✅ Application is healthy!"
                                    break
                                else
                                    echo "❌ Attempt \$i failed, retrying in 30 seconds..."
                                    sleep 30
                                fi
                            done
                        """
                    }
                }
            }
        }
    }
    
    post {
        always {
            script {
                // Clean up Docker images
                sh """
                    docker rmi ${DOCKER_IMAGE}:${env.BUILD_TAG} || true
                    docker system prune -f || true
                """
            }
        }
        success {
            echo '🎉 Pipeline succeeded! Application deployed successfully.'
            script {
                sh """
                    echo "✅ Deployment Summary:"
                    echo "🔗 Application URL: http://a33f4d4d9655c4121a50242bb0a3942b-321113.us-west-2.elb.amazonaws.com"
                    echo "🐳 Docker Image: ${DOCKER_IMAGE}:${env.BUILD_TAG}"
                    echo "📊 Monitoring: http://34.210.247.74:3000"
                    echo "📂 Repository: https://github.com/Surya-pkh/Projects/tree/main/react-trend-deployment"
                """
            }
        }
        failure {
            echo '❌ Pipeline failed! Check the logs for details.'
        }
    }
}
