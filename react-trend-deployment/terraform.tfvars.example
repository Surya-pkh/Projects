# AWS Configuration
aws_region = "us-west-2"

# Project Configuration
project_name = "trend-app"
environment  = "production"

# EC2 Key Pair (replace with your actual key pair name)
key_name = "your-ec2-key-pair-name"

# VPC Configuration
vpc_cidr            = "10.0.0.0/16"
availability_zones  = ["us-west-2a", "us-west-2b"]
private_subnets     = ["10.0.1.0/24", "10.0.2.0/24"]
public_subnets      = ["10.0.101.0/24", "10.0.102.0/24"]

# Instance Types
jenkins_instance_type    = "t3.medium"
monitoring_instance_type = "t3.medium"

# Monitoring Configuration
prometheus_retention_period = "15d"
grafana_admin_password      = "admin123"  # Change this in production

# AMI ID (Ubuntu 20.04 LTS - update for your region)
ami_id = "ami-0c02fb55956c7d316"

# Tags
monitoring_tags = {
  Environment = "production"
  Project     = "trend-app"
  Component   = "monitoring"
}
