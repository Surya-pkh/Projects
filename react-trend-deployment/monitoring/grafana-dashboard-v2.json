{
  "dashboard": {
    "id": null,
    "title": "Trend App - React Application Dashboard",
    "tags": ["trend-app", "react", "kubernetes"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Application Health Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"kubernetes-pods\", pod=~\"trend-app.*\"}",
            "legendFormat": "{{pod}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"options": {"0": {"text": "DOWN"}}, "type": "value"},
              {"options": {"1": {"text": "UP"}}, "type": "value"}
            ]
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Pod Count",
        "type": "stat",
        "targets": [
          {
            "expr": "count(kube_pod_info{pod=~\"trend-app.*\", phase=\"Running\"})",
            "legendFormat": "Running Pods"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "green", "value": 3}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "HTTP Requests Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(nginx_http_requests_total{job=\"kubernetes-pods\", pod=~\"trend-app.*\"}[5m])",
            "legendFormat": "{{pod}} - {{status}}"
          }
        ],
        "yAxes": [
          {"label": "Requests/sec"},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "container_memory_usage_bytes{pod=~\"trend-app.*\"} / 1024 / 1024",
            "legendFormat": "{{pod}} Memory (MB)"
          }
        ],
        "yAxes": [
          {"label": "Memory (MB)"},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 5,
        "title": "CPU Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{pod=~\"trend-app.*\"}[5m]) * 100",
            "legendFormat": "{{pod}} CPU %"
          }
        ],
        "yAxes": [
          {"label": "CPU %", "max": 100},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 6,
        "title": "Network I/O",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(container_network_receive_bytes_total{pod=~\"trend-app.*\"}[5m])",
            "legendFormat": "{{pod}} RX"
          },
          {
            "expr": "rate(container_network_transmit_bytes_total{pod=~\"trend-app.*\"}[5m])",
            "legendFormat": "{{pod}} TX"
          }
        ],
        "yAxes": [
          {"label": "Bytes/sec"},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "5s"
  }
}
